<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GarrisonDefense</AssemblyName>
    <RootNamespace>GarrisonDefense</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Kendi oyun klasörün; ayarlıysa derleme sonrası mod oraya kopyalanır -->
    <GameFolder Condition="'$(GameFolder)' == ''"></GameFolder>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="PackageModule" AfterTargets="Build">
    <PropertyGroup><ModOut>$(MSBuildProjectDirectory)/../dist/Modules/GarrisonDefense</ModOut></PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../_Module/SubModule.xml" DestinationFolder="$(ModOut)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOut)/bin/Win64_Shipping_Client" />
    <!-- Xbox / Game Pass sürümü DLL'i bu klasörde arar -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOut)/bin/Gaming.Desktop.x64_Shipping_Client" />
    <ItemGroup><ModFiles Include="$(ModOut)/**/*" /></ItemGroup>
    <Copy Condition="'$(GameFolder)' != ''" SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(GameFolder)/Modules/GarrisonDefense/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
